{
  // Cloudflare Workers Static Assets configuration for How Cars Work
  // Matches Worker name for Cloudflare Workers Builds (GitHub auto-deploy)
  "name": "how-car-works",
  "compatibility_date": "2026-11-23",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "cars-explained.musabadru.com",
      "custom_domain": true
    }
  ]
}
